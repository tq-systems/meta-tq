diff --git a/mkimage_imx8 b/mkimage_imx8
new file mode 100755
index 0000000..834aba9
--- /dev/null
+++ b/mkimage_imx8
@@ -0,0 +1,7 @@
+#!/bin/sh
+
+OUTLOG=mkimage.log
+SCRIPTPATH=$(dirname "$(readlink -f "${0}")")
+
+
+exec "${SCRIPTPATH}/mkimage_imx8.real" "$@" 2>&1 | tee "${OUTLOG}" >&2
