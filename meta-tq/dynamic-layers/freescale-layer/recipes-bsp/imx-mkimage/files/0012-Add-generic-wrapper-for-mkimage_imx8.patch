From 288c9de564eafcb190afc7677815967587f2d8ca Mon Sep 17 00:00:00 2001
From: Markus Niebel <Markus.Niebel@ew.tq-group.com>
Date: Thu, 24 Oct 2024 16:55:34 +0200
Subject: [PATCH] Add generic wrapper for mkimage_imx8

Add a wrapper that tees the stderr output to a log file, allowing for
more robust parsing for CSF / SRK / HAB block offsets.

To keep diff small, compile the real tool as 'mkimage_imx8.real'.
Optimize the clean target: remove $(MKIMG) clean from SoC clean
since the tool is built and called from top level dir.

Add cleaning of the generated log file to the SoC clean target
to prevent using wrong data in subsequent runs.

Upstream-Status: Inappropriate
Signed-off-by: Markus Niebel <Markus.Niebel@ew.tq-group.com>
---
 Makefile        | 14 +++++++-------
 iMX8DXL/soc.mak |  3 ++-
 iMX8QM/soc.mak  |  1 +
 iMX8QX/soc.mak  |  3 ++-
 iMX8ULP/soc.mak |  3 ++-
 iMX91/soc.mak   |  3 ++-
 iMX93/soc.mak   |  3 ++-
 iMX94/soc.mak   |  3 ++-
 iMX95/soc.mak   |  3 ++-
 mkimage_imx8    |  7 +++++++
 10 files changed, 29 insertions(+), 14 deletions(-)
 create mode 100755 mkimage_imx8

diff --git a/Makefile b/Makefile
index b14f9ce..7b39f8a 100644
--- a/Makefile
+++ b/Makefile
@@ -1,5 +1,5 @@
 
-MKIMG = $(PWD)/mkimage_imx8
+MKIMG_REAL = $(PWD)/mkimage_imx8.real
 CC = gcc
 CFLAGS ?= -g -O2 -Wall -std=c99 -static
 INCLUDE += $(CURR_DIR)/src
@@ -30,10 +30,10 @@ else
 endif
 
 #print out usage as the default target
-all: $(MKIMG) help
+all: $(MKIMG_REAL) help
 
 clean:
-	@rm -f $(MKIMG)
+	@rm -f $(MKIMG_REAL)
 	@rm -f src/build_info.h
 ifdef O
 	@$(MAKE) --no-print-directory -C $(O) -f ../$(SOC_DIR)/soc.mak clean
@@ -48,11 +48,11 @@ endif
 	@$(MAKE) --no-print-directory -C iMX95 -f soc.mak  clean
 	@$(MAKE) --no-print-directory -C iMX94 -f soc.mak  clean
 
-$(MKIMG): src/build_info.h $(SRCS)
-	@echo "Compiling mkimage_imx8"
-	$(CC) $(CFLAGS) $(SRCS) -o $(MKIMG) -I src
+$(MKIMG_REAL): src/build_info.h $(SRCS)
+	@echo "Compiling $@"
+	$(CC) $(CFLAGS) $(SRCS) -o $@ -I src
 
-bin: $(MKIMG)
+bin: $(MKIMG_REAL)
 
 src/build_info.h:
 	@echo -n '#define MKIMAGE_COMMIT 0x' > src/build_info.h
