+	GPIO_INIT_DATA_ENTRY(GPIN_2, "GPIO1_14", GPIOD_IS_IN),
+	GPIO_INIT_DATA_ENTRY(GPIN_3, "GPIO1_15", GPIOD_IS_IN),
+
+	GPIO_INIT_DATA_ENTRY(LVDS_RESET_B, "GPIO3_14",
+			     GPIOD_IS_OUT | GPIOD_ACTIVE_LOW |
+			     GPIOD_IS_OUT_ACTIVE),
+#if !defined(CONFIG_TQMA8MPXL_LVDS)
