diff --git a/arch/arm/mach-imx/imx8m/Kconfig b/arch/arm/mach-imx/imx8m/Kconfig
index 75b7588d926..3ed8aeca5e0 100644
--- a/arch/arm/mach-imx/imx8m/Kconfig
+++ b/arch/arm/mach-imx/imx8m/Kconfig
@@ -448,6 +448,16 @@ config TARGET_LIBREM5
 	select SUPPORT_SPL
 	select IMX8M_LPDDR4
 
+config TARGET_TQMA8MPXL
+	bool "TQ-Systems GmbH TQMa8MPxL SOM family"
+	select IMX8MP
+	select IMX8M_LPDDR4
+	select SUPPORT_SPL
+	select FSL_CAAM
+	select FSL_BLOB
+	select ARCH_MISC_INIT
+	select SPL_CRYPTO if SPL
+
 endchoice
 
 source "board/advantech/imx8mp_rsb3720a1/Kconfig"
@@ -484,5 +494,6 @@ source "board/variscite/imx8mn_var_som/Kconfig"
 source "board/toradex/verdin-imx8mm/Kconfig"
 source "board/toradex/verdin-imx8mp/Kconfig"
 source "board/voxelbotics/navqp/Kconfig"
+source "board/tq/tqma8mpxl/Kconfig"
 
 endif
diff --git a/board/tq/tqma8mpxl/Kconfig b/board/tq/tqma8mpxl/Kconfig
new file mode 100644
index 00000000000..a09a8445477
--- /dev/null
+++ b/board/tq/tqma8mpxl/Kconfig
@@ -0,0 +1,90 @@
+if TARGET_TQMA8MPXL
+
+config SYS_BOARD
+	default "tqma8mpxl"
+
+config SYS_VENDOR
+	default "tq"
+
+config SYS_CONFIG_NAME
+	default "tqma8mpxl"
+
+config IMX_CONFIG
+	default "board/freescale/imx8mp_evk/imximage-8mp-lpddr4.cfg"
+
+config TQMA8MPXL_DEFAULTS
+	bool
+	default y
+	select TQ_BB
+	select TQ_EEPROM
+	select TQ_RTC
+	select TQ_SDMMC
+	select TQ_SPI_NOR
+	select TQ_VARD
+	imply FSL_CAAM
+	imply SPL_CRYPTO if SPL
+	select I2C_EEPROM
+	select SPL_I2C_EEPROM if SPL
+	imply MISC
+	imply ENV_IS_NOWHERE
+	imply SYS_REDUNDAND_ENVIRONMENT
+	imply ENV_OVERWRITE
+
+choice
+	prompt "TQMa8MPxL RAM configuration"
+	default TQMA8MPXL_RAM_MULTI
+	help
+	  Select RAM configuration. Normally use default here but for
+	  specific setup it is possible to use a single RAM size.
+
+config TQMA8MPXL_RAM_MULTI
+	bool "TQMa8MPxL with 1/2/4/8 GB RAM - Single image"
+	select TQMA8MPXL_RAM_1024MB
+	select TQMA8MPXL_RAM_2048MB
+	select TQMA8MPXL_RAM_4096MB
+	select TQMA8MPXL_RAM_8192MB
+	help
+	  Build a single U-Boot for variants with 1/2/4/8 GB RAM. Select whether to use
+	  the inline ECC capability or not using config item IMX8M_DRAM_INLINE_ECC
+
+config TQMA8MPXL_RAM_SINGLE_2GB
+	bool "TQMa8MPxL with 2 GB RAM"
+	select TQMA8MPXL_RAM_2048MB
+	help
+	  Build U-Boot for variants with 2 GB RAM.  Select whether to use
+	  the inline ECC capability or not using config item IMX8M_DRAM_INLINE_ECC
+
+endchoice
+
+config TQMA8MPXL_RAM_1024MB
+	bool
+
+config TQMA8MPXL_RAM_2048MB
+	bool
+
+config TQMA8MPXL_RAM_4096MB
+	bool
+
+config TQMA8MPXL_RAM_8192MB
+	bool
+
+choice
+	prompt "TQMa8MPxL base board variant"
+	default TQMA8MPXL_BB_MBA8MPXL
+	help
+	  Select base board for TQMa8MPxL
+
+config TQMA8MPXL_BB_MBA8MPXL
+	bool "TQMa8MPxL on MBa8MPxL Starterkit"
+	imply ENV_IS_NOWHERE
+	imply SYS_REDUNDAND_ENVIRONMENT
+	imply ENV_OVERWRITE
+	help
+	  Select the MBa8MPxL starterkit for TQMa8MPxL board.
+	  This features most interfaces the CPU can provide
+
+endchoice
+
+source "board/tq/common/Kconfig"
+
+endif
