From dcb407767b128c6b97e49d925a54bcac7f1da202 Mon Sep 17 00:00:00 2001
From: Markus Niebel <Markus.Niebel@ew.tq-group.com>
Date: Wed, 5 Mar 2025 11:04:15 +0100
Subject: [PATCH 21/26] fixup! arm: dts: tqma8mpql: add U-Boot dtsi fragments

---
 arch/arm/dts/imx8mp-tqma8mpql-mba8mpxl-u-boot.dtsi | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/arch/arm/dts/imx8mp-tqma8mpql-mba8mpxl-u-boot.dtsi b/arch/arm/dts/imx8mp-tqma8mpql-mba8mpxl-u-boot.dtsi
index af2c8dc1e40..65084904824 100644
--- a/arch/arm/dts/imx8mp-tqma8mpql-mba8mpxl-u-boot.dtsi
+++ b/arch/arm/dts/imx8mp-tqma8mpql-mba8mpxl-u-boot.dtsi
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-or-later OR MIT
 /*
- * Copyright (c) 2021-2024 TQ-Systems GmbH <u-boot@ew.tq-group.com>,
+ * Copyright (c) 2021-2025 TQ-Systems GmbH <u-boot@ew.tq-group.com>,
  * D-82229 Seefeld, Germany.
  * Author: Markus Niebel
  */
@@ -9,7 +9,7 @@
 
 / {
 	config {
-		/* 32 kiB redundant env */
+		/* 64 kiB redundant env */
 		u-boot,mmc-env-offset = <0x400000>;
 		u-boot,mmc-env-offset-redundant = <0x410000>;
 	};
@@ -25,10 +25,6 @@
 	phy-reset-gpios = <&gpio4 0 GPIO_ACTIVE_LOW>;
 };
 
-&flexspi {
-	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_400M>;
-};
-
 &iomuxc {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_gpioled>, <&pinctrl_gpiobutton>,
@@ -70,6 +66,7 @@
 	assigned-clock-rates = <400000000>;
 };
 
+/* TODO: SDIO? */
 &usdhc1 {
 	bootph-pre-ram;
 	assigned-clocks = <&clk IMX8MP_CLK_USDHC1>;
-- 
2.34.1

