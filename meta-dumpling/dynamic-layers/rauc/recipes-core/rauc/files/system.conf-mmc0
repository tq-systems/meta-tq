[system]
compatible=@RAUC_BUNDLE_COMPATIBLE@
bootloader=uboot
bundle-formats=-plain

[keyring]
path=@RAUC_KEYRING_FILE@

[slot.rootfs.0]
device=/dev/mmcblk0p2
type=ext4
bootname=A

[slot.rootfs.1]
device=/dev/mmcblk0p3
type=ext4
bootname=B
